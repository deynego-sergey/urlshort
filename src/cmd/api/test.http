### Переменные окружения (задаются в http-client.env.json)
#@host = http://localhost:8080
#@username = testuser2026
#@password = SecurePassword123!

### 1. Публичные операции: Регистрация нового пользователя
POST {{host}}/v1/internal
Content-Type: application/json

{
  "action": "auth.register",
  "data": {
    "username": "wwwm@bk.ru",
    "password": "{{password}}"
  }
}

### 2. Публичные операции: Подтверждение регистрации
# Скопируйте token из логов консоли сервера (тестовый вывод)
POST {{host}}/v1/internal
Content-Type: application/json

{
  "action": "auth.confirm",
  "data": {
    "token": "873023"
  }
}

### 3. Публичные операции: Аутентификация (Вход)
POST {{host}}/v1/internal
Content-Type: application/json

{
  "action": "auth.login",
  "data": {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

> {%
    client.global.set("auth_token", response.body.access_token);
%}

### 4. Публичные операции: Ротация сессии (Refresh)
POST {{host}}/v1/internal
Content-Type: application/json

{
  "action": "auth.refresh",
  "data": {
    "refresh_token": "замените_на_refresh_token_если_не_используются_cookie"
  }
}

> {%
    client.global.set("auth_token", response.body.access_token);
%}

### 5. Публичные операции: Запрос восстановления пароля
POST {{host}}/v1/internal
Content-Type: application/json

{
  "action": "auth.request_reset",
  "data": {
    "username": "{{username}}"
  }
}

### 6. Публичные операции: Сброс пароля по токену
POST {{host}}/v1/internal
Content-Type: application/json

{
  "action": "auth.reset_password",
  "data": {
    "token": "reset_замените_на_токен_из_логов",
    "new_password": "NewSecurePassword2026!"
  }
}

### =================================================================
### Защищенные операции (Требуют Bearer Access Token)

### 7. Защищенные операции: Массовое создание коротких ссылок
POST {{host}}/v1/internal
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "link.create_batch",
  "data": {
    "items": [
      {
        "original_url": "https://google.com"
      },
      {
        "original_url": "https://github.com/gotd/td"
      }
    ]
  }
}

### 8. Защищенные операции: Получение списка ссылок пользователя
POST {{host}}/v1/internal
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "action": "link.list",
  "data": {
    "search": "google",
    "is_deleted": false
  }
}